---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.name}'s Story - #Founder`}>
  <article class="story-detail-page container">
    <div class="article-container">
      <header class="story-header">
        <div class="story-avatar-large">{entry.data.avatar}</div>
        <div class="story-meta-large">
          <h1>{entry.data.name}</h1>
          <div class="startup-badge">{entry.data.startup}</div>
        </div>
      </header>

      <div class="story-body">
        <Content />
      </div>

      <footer class="story-footer">
        <a href="/stories" class="btn-back">← Back to Stories</a>
      </footer>
    </div>
  </article>
</Layout>

<style>
  .story-detail-page {
    padding: 4rem 0;
    max-width: 1200px;
    margin: 0 auto;
  }

  .article-container {
    padding: 0;
  }

  .story-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .story-avatar-large {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e293b, #3b82f6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }

  :root[data-theme="light"] .story-avatar-large {
    background: linear-gradient(135deg, #3b82f6, #60a5fa);
  }

  .story-meta-large h1 {
    font-size: 2.5rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .startup-badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-color);
    padding: 0.4rem 1rem;
    border-radius: 99px;
    font-weight: 600;
    font-size: 1rem;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .story-body {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.8;
  }

  .story-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .story-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .story-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .btn-back {
    display: inline-block;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .btn-back:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 2rem;
    }
    .story-header {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
  }
</style>
