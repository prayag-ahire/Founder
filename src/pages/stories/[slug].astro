---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { markdownToPlain } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const siteUrl = (Astro.site ?? Astro.url).origin;
const description = entry.data.excerpt;
---

<Layout
  title={`${entry.data.name} on building ${entry.data.startup} in India`}
  description={`${entry.data.name}, founder of ${entry.data.startup}: ${description}`}
  type="article"
  keywords={[entry.data.name, entry.data.startup, 'Indian founder story', 'startup India']}
  jsonLd={[
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Founder stories', path: '/stories' },
      { name: entry.data.name, path: `/stories/${entry.id}` },
    ]),
    articleSchema({
      siteUrl,
      title: `${entry.data.name} — ${entry.data.startup}`,
      description: markdownToPlain(entry.body ?? entry.data.excerpt),
      path: `/stories/${entry.id}`,
    }),
  ]}
>
  <article class="story-detail-page container">
    <nav class="crumbs"><a href="/stories">Stories</a> / {entry.data.name}</nav>
    <header class="story-header">
      <div class="story-avatar-large">{entry.data.avatar}</div>
      <div>
        <h1>{entry.data.name}</h1>
        <p class="startup-badge">{entry.data.startup}</p>
      </div>
    </header>
    <div class="story-body">
      <Content />
    </div>
    <footer class="story-footer">
      <a href="/stories" class="pill-nav-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>More founder stories</span>
      </a>
      <a href="/guides/incorporate-in-india" class="pill-nav-link">
        <span>Incorporation Guide</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </footer>
  </article>
</Layout>

<style>
  .story-detail-page {
    padding: 3.5rem 0 4rem;
    max-width: 800px;
  }

  .crumbs {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 0.9rem;
  }

  .story-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .story-avatar-large {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e293b, #3b82f6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    margin-bottom: 0.45rem;
  }

  .startup-badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-color);
    padding: 0.3rem 0.85rem;
    border-radius: 99px;
    font-weight: 600;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .story-body {
    color: var(--text-secondary);
    font-size: 1.12rem;
    line-height: 1.85;
  }

  .story-body :global(p) {
    margin-bottom: 1.35rem;
  }

  .story-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .story-detail-page {
      padding: 1.25rem 0 2rem;
    }

    .crumbs {
      margin-bottom: 1rem;
      font-size: 0.82rem;
    }

    .story-header {
      flex-direction: row;
      align-items: center;
      gap: 0.9rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1.1rem;
    }

    .story-avatar-large {
      width: 52px;
      height: 52px;
      font-size: 1.1rem;
    }

    h1 {
      font-size: 1.35rem;
      margin-bottom: 0.25rem;
    }

    .startup-badge {
      font-size: 0.78rem;
      padding: 0.18rem 0.65rem;
    }

    .story-body {
      font-size: 0.96rem;
      line-height: 1.7;
    }

    .story-footer {
      margin-top: 1.5rem;
      padding-top: 1.15rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    .story-footer .pill-nav-link {
      justify-content: center;
      font-size: 0.82rem;
      padding: 0.6rem 0.5rem;
      white-space: nowrap;
    }
  }
</style>
