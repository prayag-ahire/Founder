---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const startups = (await getCollection('startups'))
  .sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured))
  .slice(0, 3);
const stories = (await getCollection('stories'))
  .sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured))
  .slice(0, 2);
const faqs = (await getCollection('faqs'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const siteUrl = (Astro.site ?? Astro.url).origin;

const founderPillars = [
  {
    icon: '🏛️',
    title: 'Thinking & Incorporating',
    description: 'Pvt Ltd vs LLP vs OPC. SPICe+ registration, name approval, bank account setup, and DPIIT recognition.',
    link: '/guides/incorporate-in-india',
    linkText: 'Incorporation Guide →',
  },
  {
    icon: '🚀',
    title: 'Fundraising & Grants',
    description: 'Raising angel cheques, iSAFE notes, the ₹50L Startup India Seed Fund (SISFS), cap tables, and term sheets.',
    link: '/guides/fundraising-in-india',
    linkText: 'Fundraising Guide →',
  },
  {
    icon: '🤝',
    title: 'Co-Founders & Equity',
    description: 'Splitting equity without drama, 4-year vesting with 1-year cliff, founder agreements, and 10% ESOP pools.',
    link: '/faq?tag=Equity%20%26%20ESOPs',
    linkText: 'Equity & ESOPs FAQ →',
  },
  {
    icon: '⚖️',
    title: 'Compliance, MCA & Labor Laws',
    description: 'Mandatory MCA forms (INC-20A, AOC-4, MGT-7), LLP Form 11, DSC tokens, PF/ESI labor laws, and avoiding penalties.',
    link: '/faq?tag=Compliance',
    linkText: 'Compliance & Legal FAQ →',
  },
];
---

<Layout
  title="The Playbook for Early-Stage Indian Startups"
  description={site.description}
  keywords={site.keywords}
  jsonLd={breadcrumbSchema(siteUrl, [{ name: 'Home', path: '/' }])}
>
  <section class="hero container">
    <p class="eyebrow">The Open Handbook for Indian Founders</p>
    <h1 class="hero-title">
      Build, incorporate & raise your startup in India
    </h1>
    <p class="hero-subtitle">
      No buzzwords. Practical guidance for founders on <strong>entity incorporation</strong>, <strong>angel & seed fundraising</strong>, <strong>co-founder vesting</strong>, and <strong>statutory compliance</strong>.
    </p>
    <div class="hero-actions">
      <a href="/guides" class="btn btn-primary">Browse Founder Guides</a>
      <a href="/guides/fundraising-in-india" class="btn btn-secondary">Fundraising Guide</a>
      <a href="/faq" class="btn btn-ghost">Browse all FAQs</a>
    </div>
  </section>

  <!-- Founder Pillars -->
  <section class="container home-section" aria-labelledby="pillars-heading">
    <div class="section-heading">
      <div>
        <h2 id="pillars-heading">What are you tackling right now?</h2>
        <p class="section-lead">Find clear, actionable advice for your current startup stage.</p>
      </div>
      <a href="/guides" class="section-link">All guides →</a>
    </div>
    <div class="pillars-grid">
      {founderPillars.map((pillar) => (
        <div class="pillar-card glass">
          <div class="pillar-icon">{pillar.icon}</div>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
          <a href={pillar.link} class="pillar-link">{pillar.linkText}</a>
        </div>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="faq-teaser">
    <div class="section-heading">
      <div>
        <h2 id="faq-teaser">Essential founder questions</h2>
        <p class="section-lead">What Indian founders ask before they sign an agreement or deposit capital.</p>
      </div>
      <a href="/faq" class="section-link">All FAQs →</a>
    </div>
    <div class="faq-teaser">
      {faqs.map((faq) => (
        <a href={`/faq/${faq.id}`} class="teaser-item glass">
          <h3>{faq.data.question}</h3>
          <span>Read answer</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="startup-teaser">
    <div class="section-heading">
      <div>
        <h2 id="startup-teaser">Indian startups to learn from</h2>
        <p class="section-lead">Not a hall of fame — a short list of companies that solved a real Indian problem.</p>
      </div>
      <a href="/startups" class="section-link">Directory →</a>
    </div>
    <div class="card-grid">
      {startups.map((startup) => (
        <a href={`/startups/${startup.id}`} class="mini-card glass">
          <div class="mini-logo">{startup.data.logoText}</div>
          <h3>{startup.data.name}</h3>
          <p>{startup.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="story-teaser">
    <div class="section-heading">
      <div>
        <h2 id="story-teaser">Stories from the messy middle</h2>
        <p class="section-lead">Compliance, pivots, and first customers — not highlight reels.</p>
      </div>
      <a href="/stories" class="section-link">All stories →</a>
    </div>
    <div class="card-grid stories">
      {stories.map((story) => (
        <a href={`/stories/${story.id}`} class="mini-card glass story">
          <div class="story-row">
            <div class="mini-avatar">{story.data.avatar}</div>
            <div>
              <h3>{story.data.name}</h3>
              <p class="startup-name">{story.data.startup}</p>
            </div>
          </div>
          <p>“{story.data.excerpt}”</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 6rem 0 3.5rem;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .eyebrow {
    color: var(--accent-color);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
    line-height: 1.6;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-section {
    padding: 2.5rem 0 1.5rem;
  }

  .section-lead {
    color: var(--text-secondary);
    margin-top: 0.4rem;
    max-width: 520px;
  }

  /* Pillars grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .pillar-card {
    padding: 1.75rem;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-hover-border);
  }

  .pillar-icon {
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .pillar-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pillar-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    flex-grow: 1;
  }

  .pillar-link {
    font-weight: 700;
    color: var(--accent-color);
    font-size: 0.9rem;
    margin-top: 0.5rem;
    display: inline-block;
  }

  .pillar-link:hover {
    text-decoration: underline;
  }

  .faq-teaser {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .teaser-item {
    padding: 1.25rem 1.4rem;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 100%;
    border-radius: 12px;
  }

  .teaser-item:hover {
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  .teaser-item h3 {
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .teaser-item span {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.9rem;
    margin-top: auto;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .card-grid.stories {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  .mini-card {
    padding: 1.5rem;
    color: var(--text-primary);
    display: block;
    border-radius: 12px;
  }

  .mini-card:hover {
    color: var(--text-primary);
    border-color: var(--card-hover-border);
    transform: translateY(-3px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .mini-card p {
    color: var(--text-secondary);
    margin-top: 0.6rem;
  }

  .mini-logo,
  .mini-avatar {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--logo-bg);
    color: var(--logo-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .mini-avatar {
    border-radius: 50%;
    margin-bottom: 0;
    background: linear-gradient(135deg, #1e293b, #3b82f6);
    color: #fff;
  }

  .story-row {
    display: flex;
    gap: 0.9rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .startup-name {
    color: var(--accent-color) !important;
    font-weight: 600;
    margin-top: 0.15rem !important;
  }
</style>
