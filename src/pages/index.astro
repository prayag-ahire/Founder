---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const startups = (await getCollection('startups'))
  .sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured))
  .slice(0, 3);
const stories = (await getCollection('stories'))
  .sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured))
  .slice(0, 2);
const faqs = (await getCollection('faqs'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const siteUrl = (Astro.site ?? Astro.url).origin;

const founderPillars = [
  {
    icon: '🏛️',
    tag: 'Stage 01',
    title: 'Thinking & Incorporating',
    description: 'Pvt Ltd vs LLP vs OPC, SPICe+ name approval, current account opening, and DPIIT recognition.',
    link: '/guides/incorporate-in-india',
    linkText: 'Incorporation Guide',
  },
  {
    icon: '🚀',
    tag: 'Stage 02',
    title: 'Fundraising & Grants',
    description: 'Angel cheques, iSAFE notes, the ₹50L Startup India Seed Fund (SISFS), cap tables, and term sheets.',
    link: '/guides/fundraising-in-india',
    linkText: 'Fundraising Guide',
  },
  {
    icon: '🤝',
    tag: 'Stage 03',
    title: 'Co-Founders & Equity',
    description: 'Splitting equity fairly, 4-year vesting with a 1-year cliff, founder agreements, and 10% ESOP pools.',
    link: '/faq?tag=Equity%20%26%20ESOPs',
    linkText: 'Equity & ESOPs FAQ',
  },
  {
    icon: '⚖️',
    tag: 'Stage 04',
    title: 'Compliance, MCA & GST',
    description: 'Mandatory MCA forms (INC-20A, AOC-4, MGT-7), GST LUT for exports, DSC tokens, and avoiding penalties.',
    link: '/faq?tag=Compliance',
    linkText: 'Compliance FAQ',
  },
];

const quickTopics = [
  { label: 'Pvt Ltd vs LLP', href: '/faq/pvt-ltd-vs-llp-vcs' },
  { label: 'iSAFE Notes', href: '/faq/isafe-notes' },
  { label: '₹50L SISFS Grant', href: '/faq/sisfs' },
  { label: 'DPIIT Recognition', href: '/faq/dpiit-recognition' },
  { label: 'Co-Founder Vesting', href: '/faq/cofounder-equity-vesting' },
  { label: 'GST Rules', href: '/faq/gst-registration' },
];
---

<Layout
  title="The Playbook for Early-Stage Indian Startups"
  description={site.description}
  keywords={site.keywords}
  jsonLd={breadcrumbSchema(siteUrl, [{ name: 'Home', path: '/' }])}
>
  <section class="hero container">
    <div class="eyebrow-pill">
      <span class="eyebrow-dot"></span>
      <span>The Open Handbook for Indian Founders</span>
    </div>
    <h1 class="hero-title">
      Build, incorporate & raise your <span class="gradient-text">startup in India</span>
    </h1>
    <p class="hero-subtitle">
      No buzzwords. Practical guidance on <strong>entity incorporation</strong>, <strong>angel & seed fundraising</strong>, <strong>co-founder vesting</strong>, and <strong>ROC/GST compliance</strong>.
    </p>
    <div class="hero-actions">
      <a href="/guides" class="btn btn-primary">Founder Guides</a>
      <a href="/faq" class="btn btn-secondary">Browse 35+ FAQs</a>
    </div>
    <div class="quick-topics" aria-label="Popular topics">
      <span class="quick-label">Popular:</span>
      <div class="quick-chips">
        {quickTopics.map((topic) => (
          <a href={topic.href} class="quick-chip">{topic.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder Pillars -->
  <section class="container home-section" aria-labelledby="pillars-heading">
    <div class="section-heading">
      <div class="heading-row">
        <h2 id="pillars-heading">By startup stage</h2>
        <a href="/guides" class="section-link">
          <span>All guides</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <p class="section-lead">Pick what you are tackling right now.</p>
    </div>
    <div class="pillars-grid">
      {founderPillars.map((pillar) => (
        <a href={pillar.link} class="pillar-card glass">
          <div class="pillar-top">
            <div class="pillar-icon">{pillar.icon}</div>
            <div class="pillar-title-wrap">
              <span class="pillar-stage">{pillar.tag}</span>
              <h3>{pillar.title}</h3>
            </div>
            <span class="chevron-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
          <p>{pillar.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="faq-teaser">
    <div class="section-heading">
      <div class="heading-row">
        <h2 id="faq-teaser">Essential questions</h2>
        <a href="/faq" class="section-link">
          <span>All FAQs</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <p class="section-lead">What Indian founders ask before signing an agreement or depositing capital.</p>
    </div>
    <div class="faq-teaser">
      {faqs.map((faq) => (
        <a href={`/faq/${faq.id}`} class="teaser-item glass">
          <div class="teaser-body">
            <div class="teaser-tags">
              {faq.data.tags.slice(0, 2).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <h3>{faq.data.question}</h3>
          </div>
          <span class="chevron-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="startup-teaser">
    <div class="section-heading">
      <div class="heading-row">
        <h2 id="startup-teaser">Startups to study</h2>
        <a href="/startups" class="section-link">
          <span>Directory</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <p class="section-lead">Indian companies that solved a real local or global problem.</p>
    </div>
    <div class="card-grid">
      {startups.map((startup) => (
        <a href={`/startups/${startup.id}`} class="mini-card glass startup-mini">
          <div class="mini-logo">{startup.data.logoText}</div>
          <div class="mini-content">
            <h3>{startup.data.name}</h3>
            <p>{startup.data.description}</p>
          </div>
          <span class="chevron-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-section" aria-labelledby="story-teaser">
    <div class="section-heading">
      <div class="heading-row">
        <h2 id="story-teaser">Founder stories</h2>
        <a href="/stories" class="section-link">
          <span>All stories</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
      <p class="section-lead">Compliance, pivots, and first customers — not highlight reels.</p>
    </div>
    <div class="card-grid stories">
      {stories.map((story) => (
        <a href={`/stories/${story.id}`} class="mini-card glass story">
          <div class="story-row">
            <div class="mini-avatar">{story.data.avatar}</div>
            <div class="story-meta">
              <h3>{story.data.name}</h3>
              <p class="startup-name">{story.data.startup}</p>
            </div>
            <span class="chevron-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
          <p class="story-quote">“{story.data.excerpt}”</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 4.5rem 0 2.75rem;
    text-align: center;
    max-width: 880px;
    margin: 0 auto;
  }

  .eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.28);
    color: #93c5fd;
    font-weight: 600;
    font-size: 0.8rem;
    margin-bottom: 1.15rem;
  }

  :root[data-theme="light"] .eyebrow-pill {
    color: var(--accent-hover);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow: 0 0 8px #3b82f6;
    flex-shrink: 0;
  }

  .hero-title {
    font-size: clamp(2rem, 6vw, 3.65rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    margin-bottom: 1rem;
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .hero-subtitle {
    font-size: clamp(0.98rem, 2.4vw, 1.18rem);
    color: var(--text-secondary);
    margin: 0 auto 1.75rem;
    max-width: 680px;
    line-height: 1.6;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .quick-topics {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .quick-label {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .quick-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    justify-content: center;
  }

  .quick-chip {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .quick-chip:hover {
    color: var(--text-primary);
    border-color: var(--accent-color);
    background: rgba(59, 130, 246, 0.1);
  }

  .home-section {
    padding: 2.25rem 0 1.25rem;
  }

  .section-heading {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    margin-bottom: 1.25rem;
  }

  .heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .section-lead {
    color: var(--text-secondary);
    font-size: 0.96rem;
    max-width: 560px;
  }

  /* Pillars grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .pillar-card {
    padding: 1.35rem 1.5rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    color: var(--text-primary);
    transition: transform 0.2s ease, border-color 0.2s ease;
    min-width: 0;
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .pillar-title-wrap {
    flex: 1;
    min-width: 0;
  }

  .pillar-stage {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-color);
    margin-bottom: 0.1rem;
  }

  .pillar-card h3 {
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .pillar-arrow {
    color: var(--text-secondary);
    font-weight: 700;
    font-size: 1.05rem;
    flex-shrink: 0;
  }

  .pillar-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  .pillar-link {
    font-weight: 600;
    color: var(--accent-color);
    font-size: 0.85rem;
  }

  /* FAQ teaser */
  .faq-teaser {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  .teaser-item {
    padding: 1.1rem 1.25rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    min-width: 0;
    border-radius: 14px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .teaser-item:hover {
    border-color: var(--card-hover-border);
    color: var(--text-primary);
    transform: translateY(-2px);
  }

  .teaser-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .teaser-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .teaser-item h3 {
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .teaser-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.12);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Startups & Stories */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .card-grid.stories {
    grid-template-columns: repeat(2, 1fr);
  }

  .mini-card {
    padding: 1.35rem;
    color: var(--text-primary);
    display: block;
    border-radius: 14px;
    min-width: 0;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .mini-card:hover {
    color: var(--text-primary);
    border-color: var(--card-hover-border);
    transform: translateY(-2px);
  }

  .mini-card p {
    color: var(--text-secondary);
    margin-top: 0.45rem;
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .mini-logo,
  .mini-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--logo-bg);
    color: var(--logo-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 0.85rem;
    flex-shrink: 0;
  }

  .mini-arrow {
    display: none;
  }

  .mini-avatar {
    border-radius: 50%;
    margin-bottom: 0;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    font-size: 0.92rem;
  }

  .story-row {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .story-meta {
    flex: 1;
    min-width: 0;
  }

  .startup-name {
    color: var(--accent-color) !important;
    font-weight: 600;
    margin-top: 0.1rem !important;
    font-size: 0.85rem !important;
  }

  .story-quote {
    font-style: normal;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 1.5rem 0 1.25rem;
      text-align: left;
    }

    .eyebrow-pill {
      font-size: 0.74rem;
      padding: 0.3rem 0.7rem;
      margin-bottom: 0.85rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 7.5vw, 2.2rem);
      margin-bottom: 0.65rem;
      letter-spacing: -0.035em;
    }

    .hero-subtitle {
      font-size: 0.94rem;
      margin: 0 0 1.15rem;
      line-height: 1.55;
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      margin-bottom: 1.15rem;
    }

    .hero-actions .btn {
      width: 100%;
      padding: 0.75rem 0.65rem;
      font-size: 0.9rem;
      border-radius: 12px;
      white-space: nowrap;
    }

    .quick-topics {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }

    .quick-chips {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0.4rem;
    }

    .quick-chip {
      font-size: 0.76rem;
      padding: 0.26rem 0.65rem;
    }

    .home-section {
      padding: 1.25rem 0 0.65rem;
    }

    .section-heading {
      margin-bottom: 0.85rem;
    }

    .heading-row h2 {
      font-size: 1.25rem;
      letter-spacing: -0.025em;
    }

    .section-lead {
      font-size: 0.88rem;
    }

    .pillars-grid,
    .faq-teaser,
    .card-grid,
    .card-grid.stories {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .pillar-card {
      padding: 1rem 1.1rem;
      border-radius: 14px;
      gap: 0.5rem;
    }

    .pillar-icon {
      width: 38px;
      height: 38px;
      font-size: 1.15rem;
      border-radius: 10px;
    }

    .pillar-card h3 {
      font-size: 1rem;
    }

    .pillar-card p {
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .teaser-item {
      padding: 0.9rem 1rem;
      border-radius: 12px;
    }

    .teaser-item h3 {
      font-size: 0.92rem;
    }

    .startup-mini {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding: 1rem;
    }

    .startup-mini .mini-logo {
      margin-bottom: 0;
      width: 44px;
      height: 44px;
      font-size: 0.95rem;
    }

    .startup-mini .mini-content {
      flex: 1;
      min-width: 0;
    }

    .startup-mini h3 {
      font-size: 1rem;
    }

    .startup-mini p {
      margin-top: 0.2rem;
      font-size: 0.85rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .mini-card.story {
      padding: 1rem 1.1rem;
    }

    .mini-card.story .mini-avatar {
      width: 40px;
      height: 40px;
      font-size: 0.85rem;
    }

    .mini-card.story h3 {
      font-size: 1rem;
    }

    .mini-card.story .story-quote {
      font-size: 0.88rem;
      line-height: 1.52;
      margin-top: 0.35rem;
    }
  }
</style>
