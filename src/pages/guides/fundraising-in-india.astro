    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .toc ol {
    margin-left: 1.1rem;
    color: var(--text-secondary);
  }

  .toc li {
    margin: 0.35rem 0;
  }

  h2 {
    font-size: 1.45rem;
    margin: 2.5rem 0 0.9rem;
    letter-spacing: -0.02em;
  }

  p, .steps {
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 1.2rem;
    font-size: 1.02rem;
  }

  .steps {
    padding-left: 1.2rem;
  }

  .steps li {
    margin-bottom: 0.9rem;
  }

  .steps strong {
    color: var(--text-primary);
  }

  .table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0 2rem;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    font-size: 0.95rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    vertical-align: top;
  }

  .comparison-table th {
    background: var(--input-bg);
    color: var(--text-primary);
    font-weight: 700;
  }

  .comparison-table td {
    color: var(--text-secondary);
