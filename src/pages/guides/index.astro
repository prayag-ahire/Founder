---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const siteUrl = (Astro.site ?? Astro.url).origin;

const guides = [
  {
    title: 'How to Incorporate a Startup in India (2026)',
    slug: '/guides/incorporate-in-india',
    category: 'Incorporation & Entity',
    readTime: '8 min read',
    summary:
      'Choosing between Pvt Ltd, LLP, and OPC, reserving names in SPICe+, getting DIN & DSC, depositing capital, and completing DPIIT recognition.',
    badge: 'Core Guide',
    highlights: ['Pvt Ltd vs LLP', 'SPICe+ Part A & B', 'DPIIT & Udyam', 'Zero-capital setup'],
  },
  {
    title: 'Early-Stage Fundraising & Capital in India',
    slug: '/guides/fundraising-in-india',
    category: 'Funding & Capital',
    readTime: '10 min read',
    summary:
      'Raising your first cheque: angel syndicates, iSAFE convertible notes, Startup India Seed Fund Scheme (₹50L SISFS grant), cap table dilution, and term sheets.',
    badge: 'Popular',
    highlights: ['iSAFE vs CCPS', '₹50L SISFS grant', 'Dilution math', 'Angel tax abolished'],
  },
  {
    title: 'Startup Compliance, MCA Forms & Labor Law Roadmap',
    slug: '/faq?tag=Compliance',
    category: 'Compliance & Governance',
    readTime: '7 min read',
    summary:
      'Mandatory calendar for Pvt Ltd, LLP & OPC: Form INC-20A, ADT-1, AOC-4, MGT-7, Form 11, Class 3 DSC tokens, PF/ESI, and avoiding ₹100/day penalties.',
    badge: 'Essential',
    highlights: ['INC-20A & ADT-1', 'LLP Form 11 & 8', 'DSC on MCA V3', 'Labor laws & POSH'],
  },
];
---

<Layout
  title="Founder Guides — Incorporation, Fundraising, Equity & Compliance in India"
  description="Practical, step-by-step playbooks for early-stage Indian founders. Learn how to incorporate, raise your first round, split co-founder equity, and navigate compliance."
  keywords={[
    'startup guides India',
    'incorporate startup in India',
    'fundraising guide India',
    'iSAFE notes India',
    'startup funding India',
    'early stage founder guide',
  ]}
  jsonLd={breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides' },
  ])}
>
  <div class="container guides-page">
    <header class="page-header">
      <p class="eyebrow">Playbooks for Indian Startups</p>
      <h1 class="page-title">Founder <span class="gradient-text">Guides</span></h1>
      <p class="page-subtitle">
        Everything you need to navigate the early days of starting up in India — zero fluff, zero legal jargon.
      </p>
    </header>

    <div class="guides-grid">
      {guides.map((guide) => (
        <a href={guide.slug} class="guide-card glass">
          <div class="card-top">
            <span class="category-badge">{guide.category}</span>
            <span class="read-time">{guide.readTime}</span>
          </div>
          <div class="card-title-row">
            <h2>{guide.title}</h2>
            <span class="chevron-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
          <p class="summary">{guide.summary}</p>
          <div class="highlights">
            {guide.highlights.map((h) => (
              <span class="tag">{h}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <section class="need-more glass">
      <div class="need-more-content">
        <h3>Have a specific question about early-stage startup hurdles?</h3>
        <p>Explore 35+ deep-dive answers covering GST, co-founder equity, iSAFE notes, ESOP taxation, and ROC filings.</p>
      </div>
      <a href="/faq" class="btn btn-secondary">Explore Founder FAQs</a>
    </section>
  </div>
</Layout>

<style>
  .guides-page {
    padding: 3rem 0 4.5rem;
    max-width: 920px;
  }

  .eyebrow {
    color: var(--accent-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
    margin-bottom: 0.55rem;
  }

  .guides-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .guide-card {
    display: block;
    padding: 1.75rem 2rem;
    border-radius: 16px;
    color: var(--text-primary);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .category-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #93c5fd;
    background: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.24);
    padding: 0.22rem 0.65rem;
    border-radius: 99px;
  }

  :root[data-theme="light"] .category-badge {
    color: var(--accent-hover);
    background: rgba(37, 99, 235, 0.08);
    border-color: rgba(37, 99, 235, 0.2);
  }

  .read-time {
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .card-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .guide-card h2 {
    font-size: 1.4rem;
    letter-spacing: -0.025em;
    line-height: 1.28;
  }

  .summary {
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1rem;
    font-size: 0.96rem;
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .need-more {
    padding: 1.75rem 2rem;
    border-radius: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .need-more-content h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .need-more-content p {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  @media (max-width: 640px) {
    .guides-page {
      padding: 1.25rem 0 2rem;
    }

    .eyebrow {
      font-size: 0.72rem;
      margin-bottom: 0.35rem;
    }

    .guides-grid {
      gap: 0.85rem;
      margin-bottom: 1.5rem;
    }

    .guide-card {
      padding: 1.1rem 1.15rem;
      border-radius: 14px;
    }

    .card-top {
      margin-bottom: 0.55rem;
    }

    .card-title-row {
      margin-bottom: 0.45rem;
    }

    .guide-card h2 {
      font-size: 1.12rem;
      line-height: 1.3;
    }

    .summary {
      font-size: 0.88rem;
      line-height: 1.52;
      margin-bottom: 0.75rem;
    }

    .need-more {
      flex-direction: column;
      align-items: stretch;
      padding: 1.1rem 1.15rem;
      gap: 0.85rem;
      border-radius: 14px;
    }

    .need-more-content h3 {
      font-size: 1.02rem;
    }

    .need-more-content p {
      font-size: 0.86rem;
    }

    .need-more .btn {
      width: 100%;
      text-align: center;
      border-radius: 12px;
    }
  }
</style>
