---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { orgTags, markdownToPlain } from '../lib/site';
import { breadcrumbSchema, faqPageSchema } from '../lib/schema';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const allTags = [...new Set(faqs.flatMap((faq) => faq.data.tags))];
const filters = [
  { group: 'Organization', tags: allTags.filter((tag) => orgTags.includes(tag as (typeof orgTags)[number])).sort() },
  { group: 'Topic', tags: allTags.filter((tag) => !orgTags.includes(tag as (typeof orgTags)[number])).sort() },
];

const siteUrl = (Astro.site ?? Astro.url).origin;
const initialQuery = Astro.url.searchParams.get('q') ?? '';
const initialTag = Astro.url.searchParams.get('tag') ?? '';
---

<Layout
  title="Startup Incorporation FAQ India — Pvt Ltd vs LLP, GST, DPIIT"
  description="Answers for Indian founders: Pvt Ltd vs LLP, how to register a company, GST, DPIIT recognition, ESOP tax, angel tax, NRI directors, and first-year ROC compliance."
  keywords={[
    'startup FAQ India',
    'Pvt Ltd vs LLP',
    'DPIIT recognition',
    'GST registration startup',
    'incorporate company India',
    'ESOP tax India',
    'angel tax abolished',
  ]}
  jsonLd={[
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Incorporation FAQ', path: '/faq' },
    ]),
    faqPageSchema(
      siteUrl,
      faqs.map((faq) => ({
        question: faq.data.question,
        answer: markdownToPlain(faq.body ?? '', 400),
        path: `/faq/${faq.id}`,
      }))
    ),
  ]}
>
  <section class="container faq-page">
    <header class="page-header">
      <h1 class="page-title">Incorporation <span class="gradient-text">FAQ</span></h1>
      <p class="page-subtitle">
        Practical answers on registering a startup in India — entity choice, GST, DPIIT, funding, and compliance.
        Educational, not legal advice.
      </p>
    </header>

    <div class="faq-header-wrapper">
      <div class="header-top">
        <div class="search-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" id="faq-search" placeholder="Search Pvt Ltd, GST, DPIIT…" value={initialQuery} />
        </div>
        <button id="toggle-filters" class="btn-filter" type="button" aria-expanded="false" aria-controls="filter-panel">
          Filters
          <span id="active-filter-count" class="hidden">(0)</span>
        </button>
      </div>

      <div id="filter-panel" class="collapsible-filters">
        <div class="filter-panel-inner">
          <div class="filter-header">
            <span>Filter by category</span>
            <button id="clear-filters" class="btn-clear hidden" type="button">Clear all</button>
          </div>
          {filters.map((filterGroup) => (
            <div class="filter-group-expanded">
              <span class="filter-group-label">{filterGroup.group}</span>
              <div class="filter-tags-wrap">
                {filterGroup.tags.map((tag) => (
                  <button class:list={['filter-tag', { active: tag === initialTag }]} type="button" data-tag={tag}>
                    {tag}
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div id="no-results" class="hidden">
      <h2>No matching questions</h2>
      <p>Try another search, or <button type="button" class="btn-ghost-inline" data-open-submit>submit a question</button>.</p>
    </div>

    <div class="faq-list" id="faq-list">
      {faqs.map(async (faq) => {
        const { Content } = await render(faq);
        return (
          <article class="faq-item glass" data-tags={faq.data.tags.join(',')} id={faq.id}>
            <h2>
              <button class="faq-question" type="button" aria-expanded="false" aria-controls={`${faq.id}-answer`}>
                <span class="q-content">
                  <span class="q-title">{faq.data.question}</span>
                  <span class="faq-tags-inline">
                    {faq.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </span>
                </span>
                <span class="faq-icon" aria-hidden="true">+</span>
              </button>
            </h2>
            <div class="faq-answer" id={`${faq.id}-answer`}>
              <div class="faq-answer-inner prose">
                <Content />
                <a class="faq-permalink" href={`/faq/${faq.id}`}>Open full page</a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const questions = document.querySelectorAll('.faq-question');
    questions.forEach((question) => {
      question.addEventListener('click', () => {
        const item = question.closest('.faq-item');
        const answer = item.querySelector('.faq-answer');
        const isOpen = item.classList.contains('active');

        document.querySelectorAll('.faq-item').forEach((el) => {
          el.classList.remove('active');
          el.querySelector('.faq-answer').style.maxHeight = '0px';
          el.querySelector('.faq-icon').textContent = '+';
          el.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
        });

        if (!isOpen) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          question.querySelector('.faq-icon').textContent = '−';
          question.setAttribute('aria-expanded', 'true');
        }
      });
    });

    const toggleFiltersBtn = document.getElementById('toggle-filters');
    const filterPanel = document.getElementById('filter-panel');
    const filterTags = document.querySelectorAll('.filter-tag');
    const searchInput = document.getElementById('faq-search');
    const activeFilterCount = document.getElementById('active-filter-count');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const noResults = document.getElementById('no-results');
    const faqItems = Array.from(document.querySelectorAll('.faq-item'));
    const params = new URLSearchParams(window.location.search);
    const activeFilters = new Set(params.getAll('tag').filter(Boolean));

    filterTags.forEach((tagBtn) => {
      if (activeFilters.has(tagBtn.getAttribute('data-tag'))) {
        tagBtn.classList.add('active');
      }
    });

    toggleFiltersBtn.addEventListener('click', () => {
      const open = filterPanel.classList.toggle('open');
      toggleFiltersBtn.classList.toggle('active-panel', open);
      toggleFiltersBtn.setAttribute('aria-expanded', String(open));
    });

    filterTags.forEach((tagBtn) => {
      tagBtn.addEventListener('click', () => {
        const tag = tagBtn.getAttribute('data-tag');
        if (activeFilters.has(tag)) {
          activeFilters.delete(tag);
          tagBtn.classList.remove('active');
        } else {
          activeFilters.add(tag);
          tagBtn.classList.add('active');
        }
        updateFilters();
      });
    });

    clearFiltersBtn.addEventListener('click', () => {
      activeFilters.clear();
      filterTags.forEach((t) => t.classList.remove('active'));
      updateFilters();
    });

    searchInput.addEventListener('input', updateFilters);

    function updateFilters() {
      activeFilterCount.textContent = `(${activeFilters.size})`;
      activeFilterCount.classList.toggle('hidden', activeFilters.size === 0);
      clearFiltersBtn.classList.toggle('hidden', activeFilters.size === 0);
      toggleFiltersBtn.classList.toggle('has-filters', activeFilters.size > 0);

      const searchTerm = searchInput.value.toLowerCase();
      let matchCount = 0;

      faqItems.forEach((item) => {
        const textMatch = !searchTerm || item.textContent.toLowerCase().includes(searchTerm);
        const itemTags = item.getAttribute('data-tags').split(',');
        const filterMatch = activeFilters.size === 0 || [...activeFilters].some((filter) => itemTags.includes(filter));
        const visible = textMatch && filterMatch;
        item.classList.toggle('hidden', !visible);
        if (visible) matchCount += 1;
      });

      noResults.classList.toggle('hidden', matchCount !== 0);
    }

    updateFilters();
  });
</script>

<style>
  .faq-page {
    padding: 3rem 0 4rem;
  }

  .faq-header-wrapper {
    position: sticky;
    top: 64px;
    z-index: 10;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    border-radius: 99px;
    width: 100%;
    max-width: 420px;
    gap: 0.8rem;
    color: var(--text-secondary);
  }

  .search-box:focus-within {
    border-color: var(--accent-color);
    color: var(--text-primary);
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    width: 100%;
    font-size: 0.95rem;
  }

  .btn-filter,
  .btn-clear {
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
  }

  .btn-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.45rem 1rem;
    white-space: nowrap;
  }

  .btn-filter.has-filters,
  .btn-filter.active-panel {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .btn-clear {
    background: transparent;
    border: 1px solid #ef4444;
    color: #ef4444;
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
  }

  .collapsible-filters {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .collapsible-filters.open {
    max-height: 480px;
    opacity: 1;
    margin-top: 1.25rem;
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .filter-group-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .filter-group-expanded {
    margin-bottom: 1rem;
  }

  .filter-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-tag {
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.35rem 0.9rem;
    border-radius: 99px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .filter-tag.active {
    background: var(--accent-color);
    color: #fff;
    border-color: var(--accent-color);
  }

  .faq-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 1.25rem;
    align-items: start;
  }

  .faq-item h2 {
    font-size: inherit;
    font-weight: inherit;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 1.4rem;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .q-content {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .q-title {
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .faq-tags-inline {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .faq-icon {
    font-size: 1.5rem;
    color: var(--text-secondary);
    line-height: 1;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer-inner {
    padding: 0 1.4rem 1.4rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .faq-permalink {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
  }

  .faq-item.hidden,
  .hidden {
    display: none !important;
  }

  #no-results {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-secondary);
  }

  .btn-ghost-inline {
    background: none;
    border: none;
    color: var(--accent-color);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .header-top {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
