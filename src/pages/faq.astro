---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { getCollection, render } from 'astro:content';

const faqsCollection = await getCollection('faqs');
const faqs = faqsCollection.sort((a, b) => a.data.order - b.data.order);

const filters = [
  { group: "Organization", tags: ["Sole Proprietorship", "LLP", "Pvt Limited", "One Person Company", "Partnership Firm"] },
  { group: "Topic", tags: ["Taxes & GST", "Liability", "Equity & ESOP", "Setup", "Compliance", "Gov Schemes", "Funding", "FDI"] }
];
---
<Layout title="Incorporation FAQ - #Founder">
  <section class="container faq-page">
    <div class="faq-header-wrapper">
      <div class="header-top">
        <div class="search-box">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="text" id="faq-search" placeholder="Search questions..." />
        </div>
        <div class="header-actions">
          <button id="toggle-filters" class="btn-filter">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            Filters
            <span id="active-filter-count" class="hidden">(0)</span>
          </button>
        </div>
      </div>

      <div id="filter-panel" class="collapsible-filters">
        <div class="filter-panel-inner">
          <div class="filter-header">
            <span>Filter by Category</span>
            <button id="clear-filters" class="btn-clear hidden">Clear All</button>
          </div>
          {filters.map(filterGroup => (
            <div class="filter-group-expanded">
              <span class="filter-group-label">{filterGroup.group}</span>
              <div class="filter-tags-wrap">
                {filterGroup.tags.map(tag => (
                  <button class="filter-tag" data-tag={tag}>{tag}</button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="faq-layout">
      <div class="faq-content">
        <div id="no-results" class="hidden">
          <h3>No matching questions found</h3>
          <p>Try adjusting your search or clearing the filters.</p>
        </div>

        <div class="faq-list" id="faq-list">
          {faqs.map(async (faq, i) => {
            const { Content } = await render(faq);
            return (
              <div class={`faq-item glass`} data-tags={faq.data.tags.join(',')}>
                <button class="faq-question">
                  <div class="q-content">
                    <h3>{faq.data.question}</h3>
                    <div class="faq-tags-inline">
                      {faq.data.tags.map(tag => (
                        <span class="inline-tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-answer">
                  <div class="faq-answer-inner prose">
                    <Content />
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Accordion Logic
    const questions = document.querySelectorAll('.faq-question');
    questions.forEach(question => {
      question.addEventListener('click', () => {
        const item = question.parentElement;
        const answer = question.nextElementSibling;
        const isOpen = item.classList.contains('active');
        
        document.querySelectorAll('.faq-item').forEach(el => {
          el.classList.remove('active');
          el.querySelector('.faq-answer').style.maxHeight = '0px';
          el.querySelector('.faq-icon').textContent = '+';
        });

        if (!isOpen) {
          item.classList.add('active');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          question.querySelector('.faq-icon').textContent = '−';
        }
      });
    });

    // Filter Logic
    const toggleFiltersBtn = document.getElementById('toggle-filters');
    const filterPanel = document.getElementById('filter-panel');
    const filterTags = document.querySelectorAll('.filter-tag');
    const searchInput = document.getElementById('faq-search');
    const activeFilterCount = document.getElementById('active-filter-count');
    const clearFiltersBtn = document.getElementById('clear-filters');
    const noResults = document.getElementById('no-results');
    const faqItems = Array.from(document.querySelectorAll('.faq-item'));
    
    let activeFilters = new Set();

    toggleFiltersBtn.addEventListener('click', () => {
      filterPanel.classList.toggle('open');
      toggleFiltersBtn.classList.toggle('active-panel');
    });

    filterTags.forEach(tagBtn => {
      tagBtn.addEventListener('click', () => {
        const tag = tagBtn.getAttribute('data-tag');
        if (activeFilters.has(tag)) {
          activeFilters.delete(tag);
          tagBtn.classList.remove('active');
        } else {
          activeFilters.add(tag);
          tagBtn.classList.add('active');
        }
        updateFilters();
      });
    });

    clearFiltersBtn.addEventListener('click', () => {
      activeFilters.clear();
      filterTags.forEach(t => t.classList.remove('active'));
      updateFilters();
    });

    searchInput.addEventListener('input', () => {
      updateFilters();
    });

    function updateFilters() {
      activeFilterCount.textContent = `(${activeFilters.size})`;
      if (activeFilters.size > 0) {
        activeFilterCount.classList.remove('hidden');
        clearFiltersBtn.classList.remove('hidden');
        toggleFiltersBtn.classList.add('has-filters');
      } else {
        activeFilterCount.classList.add('hidden');
        clearFiltersBtn.classList.add('hidden');
        toggleFiltersBtn.classList.remove('has-filters');
      }

      const searchTerm = searchInput.value.toLowerCase();
      let matchCount = 0;

      faqItems.forEach(item => {
        let textMatch = true;
        let filterMatch = true;

        if (searchTerm) {
          textMatch = item.textContent.toLowerCase().includes(searchTerm);
        }

        if (activeFilters.size > 0) {
          const itemTags = item.getAttribute('data-tags').split(',');
          filterMatch = Array.from(activeFilters).some(filter => itemTags.includes(filter));
        }

        if (textMatch && filterMatch) {
          item.classList.remove('hidden');
          matchCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      noResults.style.display = matchCount === 0 ? 'block' : 'none';
    }

    // Initialize state on load
    updateFilters();
  });
</script>

<style>
  .faq-page {
    padding: 0 0 4rem;
  }

  .faq-header-wrapper {
    position: sticky;
    top: 60px;
    z-index: 10;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-color);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }

  .header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .search-box {
    display: flex;
    align-items: center;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    padding: 0.5rem 1rem;
    border-radius: 99px;
    width: 100%;
    max-width: 400px;
    gap: 0.8rem;
    color: var(--text-secondary);
    transition: all 0.3s ease;
  }

  .search-box:focus-within {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    color: var(--text-primary);
  }

  .search-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-primary);
    width: 100%;
    font-size: 0.95rem;
  }

  .search-box input::placeholder {
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .btn-filter {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.4rem 1rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-filter:hover {
    background: var(--btn-ghost-hover);
  }

  .btn-filter.active-panel {
    border-color: var(--text-primary);
  }

  .btn-filter.has-filters {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  #active-filter-count.hidden {
    display: none;
  }

  .filter-panel-inner {
    padding-top: 1rem;
    border-top: 1px dashed var(--border-color);
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .btn-clear.hidden {
    display: none;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid #ef4444;
    color: #ef4444;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-clear:hover {
    background: #ef4444;
    color: #fff;
  }

  .collapsible-filters {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .collapsible-filters.open {
    max-height: 500px;
    opacity: 1;
    margin-top: 1.5rem;
    padding-bottom: 1rem;
  }

  .filter-group-expanded {
    margin-bottom: 1.5rem;
  }

  .filter-group-expanded:last-child {
    margin-bottom: 0;
  }

  .filter-group-label {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    margin-bottom: 0.8rem;
  }

  .filter-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .filter-tag {
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.4rem 1rem;
    border-radius: 99px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-tag:hover {
    background: var(--btn-ghost-hover);
    color: var(--text-primary);
  }

  .filter-tag.active {
    background: var(--accent-color);
    color: #fff;
    border-color: var(--accent-color);
  }

  .faq-layout {
    display: block;
  }

  .faq-content {
    min-width: 0;
  }

  .faq-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .faq-item {
    padding: 0;
    overflow: hidden;
    break-inside: avoid;
  }

  .faq-item.hidden {
    display: none !important;
  }

  .faq-question {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 1.5rem;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .q-content {
    flex: 1;
    padding-right: 1.5rem;
  }

  .faq-question h3 {
    font-size: 1.1rem;
    margin-bottom: 0.8rem;
  }

  .faq-tags-inline {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .inline-tag {
    font-size: 0.75rem;
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 500;
  }

  :root[data-theme="light"] .inline-tag {
    color: var(--accent-hover);
  }

  .faq-icon {
    font-size: 1.5rem;
    color: var(--text-secondary);
    font-weight: 300;
    line-height: 1;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-answer-inner {
    padding: 0 1.5rem 1.5rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
