---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const startupEntries = await getCollection('startups');
  return startupEntries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.name} - #Founder`}>
  <div class="startup-hero glass">
    <div class="container">
      <div class="startup-header">
        <div class="startup-logo">{entry.data.logoText}</div>
        <div class="startup-title">
          <h1>{entry.data.name}</h1>
          <p class="startup-tagline">{entry.data.description}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="container startup-body">
    <article class="prose glass-prose">
      <Content />
    </article>
    
    <div class="startup-sidebar">
      <div class="sidebar-widget glass">
        <h3>Company Details</h3>
        <ul class="widget-list">
          <li><strong>Industry:</strong> Tech</li>
          <li><strong>Stage:</strong> Growth</li>
        </ul>
        <a href="/startups" class="btn btn-secondary mt-4">← Back to Directory</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .startup-hero {
    padding: 4rem 0;
    margin-bottom: 3rem;
    border-radius: 0;
    border-left: none;
    border-right: none;
    background: var(--header-bg);
  }

  .startup-header {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .startup-logo {
    width: 120px;
    height: 120px;
    border-radius: 30px;
    background: var(--logo-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 800;
    color: var(--logo-text);
    box-shadow: var(--card-shadow);
    flex-shrink: 0;
  }

  .startup-title h1 {
    font-size: 3rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .startup-tagline {
    font-size: 1.25rem;
    color: var(--text-secondary);
  }

  .startup-body {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    padding-bottom: 5rem;
  }

  .glass-prose {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 3rem;
    box-shadow: var(--card-shadow);
  }

  .prose {
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .prose h1, .prose h2, .prose h3 {
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .sidebar-widget {
    padding: 2rem;
  }

  .sidebar-widget h3 {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
  }

  .widget-list {
    list-style: none;
    padding: 0;
  }

  .widget-list li {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    color: var(--text-secondary);
  }

  .widget-list li:last-child {
    border-bottom: none;
  }

  .widget-list strong {
    color: var(--text-primary);
  }

  .mt-4 {
    margin-top: 1.5rem;
    display: block;
    text-align: center;
  }

  .btn-secondary {
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: var(--btn-ghost-hover);
    border-color: var(--accent-color);
  }
</style>
