---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../lib/schema';

const stories = await getCollection('stories');
const siteUrl = (Astro.site ?? Astro.url).origin;
---

<Layout
  title="Indian Founder Stories"
  description="First-person stories from Indian founders on incorporation, compliance, pivots, and first customers — the part that does not fit in a pitch deck."
  keywords={['Indian founder stories', 'startup journey India', 'fintech founder India', 'startup pivot']}
  jsonLd={breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Founder stories', path: '/stories' },
  ])}
>
  <section class="stories-page container">
    <header class="page-header">
      <p class="eyebrow">From the Messy Middle</p>
      <h1 class="page-title">Founder <span class="gradient-text">stories</span></h1>
      <p class="page-subtitle">
        Real operating details from people building companies in India — RBI paper, kirana routes, clinic admin, hardware duties.
      </p>
    </header>

    <div class="stories-grid">
      {stories.map((story) => (
        <a href={`/stories/${story.id}`} class="story-card glass">
          <div class="story-header">
            <div class="story-avatar">{story.data.avatar}</div>
            <div class="story-meta">
              <h2>{story.data.name}</h2>
              <span class="startup-name">{story.data.startup}</span>
            </div>
            <span class="chevron-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </span>
          </div>
          <p class="excerpt">“{story.data.excerpt}”</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .stories-page {
    padding: 3rem 0 5rem;
  }

  .eyebrow {
    color: var(--accent-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8rem;
    margin-bottom: 0.55rem;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
  }

  .story-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    color: var(--text-primary);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .story-card:hover {
    transform: translateY(-3px);
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  .story-header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .story-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .story-meta {
    flex: 1;
    min-width: 0;
  }

  .story-card h2 {
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .startup-name {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .card-arrow {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.12);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .excerpt {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.6;
    flex: 1;
  }

  @media (max-width: 640px) {
    .stories-page {
      padding: 1.25rem 0 2rem;
    }

    .eyebrow {
      font-size: 0.72rem;
      margin-bottom: 0.35rem;
    }

    .stories-grid {
      gap: 0.75rem;
    }

    .story-card {
      padding: 1.05rem 1.15rem;
      border-radius: 14px;
      gap: 0.65rem;
    }

    .story-avatar {
      width: 42px;
      height: 42px;
      font-size: 0.88rem;
    }

    .story-card h2 {
      font-size: 1.04rem;
    }

    .excerpt {
      font-size: 0.88rem;
      line-height: 1.55;
    }
  }
</style>
