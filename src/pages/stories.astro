---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../lib/schema';

const stories = await getCollection('stories');
const siteUrl = (Astro.site ?? Astro.url).origin;
---

<Layout
  title="Indian Founder Stories"
  description="First-person stories from Indian founders on incorporation, compliance, pivots, and first customers — the part that does not fit in a pitch deck."
  keywords={['Indian founder stories', 'startup journey India', 'fintech founder India', 'startup pivot']}
  jsonLd={breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'Founder stories', path: '/stories' },
  ])}
>
  <section class="stories-page container">
    <header class="page-header">
      <h1 class="page-title">Founder <span class="gradient-text">stories</span></h1>
      <p class="page-subtitle">
        Real operating details from people building companies in India — RBI paper, kirana routes, clinic admin, hardware duties.
      </p>
    </header>

    <div class="stories-grid">
      {stories.map((story) => (
        <a href={`/stories/${story.id}`} class="story-card glass">
          <div class="story-header">
            <div class="story-avatar">{story.data.avatar}</div>
            <div>
              <h2>{story.data.name}</h2>
              <span class="startup-name">{story.data.startup}</span>
            </div>
          </div>
          <p class="excerpt">“{story.data.excerpt}”</p>
          <span class="read-more">Read full story</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .stories-page {
    padding: 3rem 0 5rem;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .story-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    color: var(--text-primary);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .story-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  .story-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .story-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e293b, #3b82f6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
  }

  .story-card h2 {
    font-size: 1.2rem;
  }

  .startup-name {
    color: var(--accent-color);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .excerpt {
    color: var(--text-secondary);
    font-style: italic;
    line-height: 1.65;
    flex: 1;
  }

  .read-more {
    margin-top: 1.25rem;
    font-weight: 600;
    color: var(--accent-color);
  }
</style>
