---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="That page is not on #Founder. Try the incorporation guide or FAQ for Indian founders."
  noindex
>
  <section class="container not-found">
    <h1>This page is not incorporated yet.</h1>
    <p>The link may be old. These are the useful doors:</p>
    <div class="links">
      <a href="/guides/incorporate-in-india" class="btn btn-primary">Incorporation guide</a>
      <a href="/faq" class="btn btn-secondary">FAQ</a>
      <a href="/" class="btn btn-secondary">Home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 7rem 0;
    text-align: center;
    max-width: 640px;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  p {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
