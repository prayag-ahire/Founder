---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { markdownToPlain } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const faqs = await getCollection('faqs');
  return faqs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, faqs },
  }));
}

const { entry, faqs } = Astro.props;
const { Content } = await render(entry);
const siteUrl = (Astro.site ?? Astro.url).origin;
const related = faqs
  .filter((faq) => faq.id !== entry.id && faq.data.tags.some((tag) => entry.data.tags.includes(tag)))
  .slice(0, 4);
const description = markdownToPlain(entry.body ?? entry.data.question);
---

<Layout
  title={entry.data.question}
  description={description}
  type="article"
  keywords={[...entry.data.tags, 'startup India', 'incorporation']}
  jsonLd={[
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Incorporation FAQ', path: '/faq' },
      { name: entry.data.question, path: `/faq/${entry.id}` },
    ]),
    faqPageSchema(siteUrl, [
      { question: entry.data.question, answer: markdownToPlain(entry.body ?? entry.data.question, 500), path: `/faq/${entry.id}` },
    ]),
    articleSchema({
      siteUrl,
      title: entry.data.question,
      description,
      path: `/faq/${entry.id}`,
      type: 'TechArticle',
    }),
  ]}
>
  <article class="container article">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/faq" class="pill-nav-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
        <span>All FAQs</span>
      </a>
    </nav>
    <header class="article-header">
      <div class="tags">
        {entry.data.tags.map((tag) => (
          <a class="tag" href={`/faq?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
      <h1>{entry.data.question}</h1>
    </header>
    <div class="prose glass prose-card">
      <Content />
    </div>
    <p class="disclaimer">This is educational information, not legal, tax, or FEMA advice. Confirm the current MCA, GST, and RBI position with a professional before you file.</p>

    {related.length > 0 && (
      <aside class="related">
        <h2>Related questions</h2>
        <ul>
          {related.map((faq) => (
            <li><a href={`/faq/${faq.id}`}>{faq.data.question}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Layout>

<style>
  .article {
    max-width: 820px;
    padding: 3.5rem 0 4rem;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin-bottom: 1.25rem;
  }

  .back-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.7rem;
    border-radius: 99px;
    background: var(--btn-ghost-bg);
    border: 1px solid var(--border-color);
    font-weight: 600;
    font-size: 0.82rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }

  .tag {
    text-decoration: none;
  }

  h1 {
    font-size: clamp(1.55rem, 4vw, 2.4rem);
    letter-spacing: -0.035em;
    line-height: 1.22;
    margin-bottom: 1.25rem;
  }

  .disclaimer {
    color: var(--text-secondary);
  }

  .prose-card {
    padding: 1.75rem 2rem;
    border-radius: 16px;
  }

  .prose {
    color: var(--text-secondary);
    font-size: 1.04rem;
    line-height: 1.78;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(p) {
    margin-bottom: 1.2rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2rem 1.2rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  .disclaimer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.92rem;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related h2 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
  }

  .related ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .related a {
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .article {
      padding: 1.25rem 0 2.5rem;
    }

    .crumbs {
      flex-wrap: wrap;
      row-gap: 0.2rem;
      font-size: 0.82rem;
      margin-bottom: 1rem;
    }

    .tags {
      margin-bottom: 0.75rem;
    }

    h1 {
      font-size: clamp(1.38rem, 6.5vw, 1.75rem);
      margin-bottom: 1rem;
    }

    .prose {
      font-size: 0.94rem;
      line-height: 1.65;
    }

    .prose-card {
      padding: 1.15rem 1.2rem;
      border-radius: 14px;
    }

    .prose :global(pre),
    .prose :global(table),
    .prose :global(a) {
      overflow-wrap: anywhere;
    }

    .disclaimer {
      margin-top: 1.5rem;
      font-size: 0.85rem;
    }

    .related {
      margin-top: 1.75rem;
    }
  }
</style>
