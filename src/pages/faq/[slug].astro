---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { markdownToPlain } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqPageSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const faqs = await getCollection('faqs');
  return faqs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, faqs },
  }));
}

const { entry, faqs } = Astro.props;
const { Content } = await render(entry);
const siteUrl = (Astro.site ?? Astro.url).origin;
const related = faqs
  .filter((faq) => faq.id !== entry.id && faq.data.tags.some((tag) => entry.data.tags.includes(tag)))
  .slice(0, 4);
const description = markdownToPlain(entry.body ?? entry.data.question);
---

<Layout
  title={entry.data.question}
  description={description}
  type="article"
  keywords={[...entry.data.tags, 'startup India', 'incorporation']}
  jsonLd={[
    breadcrumbSchema(siteUrl, [
      { name: 'Home', path: '/' },
      { name: 'Incorporation FAQ', path: '/faq' },
      { name: entry.data.question, path: `/faq/${entry.id}` },
    ]),
    faqPageSchema(siteUrl, [
      { question: entry.data.question, answer: markdownToPlain(entry.body ?? entry.data.question, 500), path: `/faq/${entry.id}` },
    ]),
    articleSchema({
      siteUrl,
      title: entry.data.question,
      description,
      path: `/faq/${entry.id}`,
      type: 'TechArticle',
    }),
  ]}
>
  <article class="container article">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/faq">Incorporation FAQ</a>
      <span>/</span>
      <span>Answer</span>
    </nav>
    <header>
      <div class="tags">
        {entry.data.tags.map((tag) => (
          <a class="tag" href={`/faq?tag=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
      <h1>{entry.data.question}</h1>
      <p class="lede">A practical answer for founders incorporating or running a startup in India.</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="disclaimer">This is educational information, not legal, tax, or FEMA advice. Confirm the current MCA, GST, and RBI position with a professional before you file.</p>

    {related.length > 0 && (
      <aside class="related">
        <h2>Related questions</h2>
        <ul>
          {related.map((faq) => (
            <li><a href={`/faq/${faq.id}`}>{faq.data.question}</a></li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</Layout>

<style>
  .article {
    max-width: 820px;
    padding: 3.5rem 0 4rem;
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }

  .tag {
    text-decoration: none;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .lede,
  .disclaimer {
    color: var(--text-secondary);
  }

  .lede {
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .prose {
    color: var(--text-secondary);
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .prose :global(p) {
    margin-bottom: 1.2rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2rem 1.2rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(strong) {
    color: var(--text-primary);
  }

  .disclaimer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.92rem;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related h2 {
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
  }

  .related ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .related a {
    font-weight: 600;
  }
</style>
