---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="About - #Founder">
  <article class="about-page container">
    <header class="about-header">
      <h1 class="about-title">About <span class="gradient-text">#Founder</span></h1>
      <p class="about-subtitle">A community built by founders, for founders.</p>
    </header>

    <div class="about-content">
      <section class="about-section">
        <h2>Our Purpose</h2>
        <p>
          <strong>#Founder</strong> simplifies the entrepreneurial journey. Whether you are figuring out complex incorporation laws, choosing between a Pvt Limited and an LLP, or looking for early-stage inspiration, this platform gives you direct, clear answers.
        </p>
      </section>

      <section class="about-section">
        <h2>Feature Your Startup</h2>
        <p>
          Want to see your organization listed alongside the best upcoming companies? We constantly curate innovative startups to showcase to our community. Simply use our official application to register your organization's details and mission.
        </p>
        <div class="action-row">
          <a href="#" class="btn btn-primary">Register Your Startup →</a>
        </div>
      </section>

      <section class="about-section">
        <h2>Join the Community</h2>
        <p>
          Building a startup can be lonely, but you don't have to do it alone. Network with fellow founders who are in the exact same boat as you. We regularly discuss strategies, share resources, and help each other grow.
        </p>
        <div class="community-links">
          <a href="#" class="social-link reddit">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.03 12.06c0-1.15-.93-2.08-2.08-2.08-.6 0-1.14.26-1.52.67-1.46-1.04-3.48-1.7-5.74-1.8l.98-4.63 4.02.86c.03.73.64 1.3 1.38 1.3 1.15 0 2.08-.93 2.08-2.08 0-1.15-.93-2.08-2.08-2.08-.73 0-1.37.38-1.72.96l-4.43-.95c-.24-.05-.48.1-.54.34l-1.07 5.06c-2.3.1-4.35.78-5.83 1.83-.37-.4-.9-.67-1.49-.67-1.15 0-2.08.93-2.08 2.08 0 .86.53 1.6 1.28 1.9-.03.22-.05.44-.05.67 0 3.73 4.48 6.75 10 6.75s10-3.02 10-6.75c0-.23-.02-.45-.05-.67.76-.3 1.3-1.04 1.3-1.9zM7.4 14.5c0-.82.67-1.49 1.49-1.49.82 0 1.49.67 1.49 1.49 0 .82-.67 1.49-1.49 1.49-.82 0-1.49-.67-1.49-1.49zm7.76 3.65c-1.3.65-3.84.8-5.16 0-.2-.1-.28-.35-.16-.54.12-.2.37-.28.57-.18 1 .5 3.12.63 4.18 0 .2-.1.45-.02.55.18.1.2.02.45-.18.54zm.64-2.16c-.82 0-1.49-.67-1.49-1.49 0-.82.67-1.49 1.49-1.49.82 0 1.49.67 1.49 1.49 0 .82-.67 1.49-1.49 1.49z"/></svg>
            r/Founder
          </a>
          <a href="#" class="social-link whatsapp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.01 2.01A10 10 0 0 0 2 12c0 1.76.46 3.42 1.29 4.88L2 22l5.24-1.25A9.97 9.97 0 0 0 12 22.01a10 10 0 1 0 .01-20zm0 18.2a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.1.74.75-3.03-.2-.31A8.17 8.17 0 0 1 3.8 12 8.2 8.2 0 1 1 12 20.21zm4.51-6.17c-.24-.12-1.46-.72-1.69-.8-.23-.08-.4-.12-.56.12-.17.25-.64.8-.78.97-.15.17-.29.2-.53.07-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.22-1.45-1.37-1.69-.15-.25-.02-.38.1-.5.11-.11.24-.29.36-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.49-.4-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.9 2.42 1.02 2.58c.12.17 1.76 2.69 4.26 3.77 2.11.9 2.5.72 2.94.67.43-.05 1.46-.6 1.66-1.18.2-.58.2-1.08.15-1.18-.06-.1-.23-.15-.47-.27z"/></svg>
            Founder's WhatsApp
          </a>
        </div>
      </section>
    </div>

    <div class="testimonial-section">
      <blockquote class="about-quote">
        "Let's plant our startups like beautiful flowers in the garden of India, and help each other flourish by nurturing them together."
      </blockquote>
      <div class="quote-author">— #Founder Community</div>
    </div>
  </article>
</Layout>

<style>
  .about-page {
    /* Viewport height minus header (60px) and footer (~150px) to ensure no scrolling */
    min-height: calc(100vh - 210px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2rem 0;
    max-width: 1400px; /* Use the wide width */
    margin: 0 auto;
  }

  .about-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .about-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.05em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .about-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .about-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  .about-section h2 {
    font-size: 1.35rem;
    color: var(--text-primary);
    margin-bottom: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }

  .about-section p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .about-section p:last-of-type {
    margin-bottom: 0;
  }

  .about-section strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Actions & Links */
  .action-row {
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1.4rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--text-primary);
    color: var(--bg-color);
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    background: #fff;
    color: #000;
    box-shadow: 0 4px 20px rgba(255,255,255,0.1);
  }

  .community-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .social-link.reddit:hover {
    color: #ff4500;
  }

  .social-link.whatsapp:hover {
    color: #25d366;
  }

  .testimonial-section {
    margin-top: 5rem;
    padding-top: 4rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .about-quote {
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
    font-style: italic;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .quote-author {
    color: var(--accent-color);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Responsive fallback */
  @media (max-width: 900px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .about-page {
      min-height: auto;
      padding: 4rem 0;
    }
    .about-quote {
      font-size: 1.4rem;
    }
  }
</style>
