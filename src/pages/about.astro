---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { breadcrumbSchema } from '../lib/schema';

const siteUrl = (Astro.site ?? Astro.url).origin;
---

<Layout
  title="About #Founder — a community for Indian founders"
  description="Founder is a free resource from Karpav Technology for Indian founders: incorporation answers, startup case studies, and stories from people building companies in India."
  jsonLd={breadcrumbSchema(siteUrl, [
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ])}
>
  <article class="about-page container">
    <header class="about-header">
      <h1 class="about-title">About <span class="gradient-text">{site.name}</span></h1>
      <p class="about-subtitle">Built for Indian founders who need clear answers, not another pitch-deck feed.</p>
    </header>

    <div class="about-content">
      <section class="about-section">
        <h2>Why this exists</h2>
        <p>
          Starting a company in India means choosing between a Pvt Ltd, LLP, and OPC, then living with GST, ROC filings, and — if you raise — a cap table investors will actually sign. {site.name} collects those answers in one place, next to stories from people who already made the mess.
        </p>
      </section>

      <section class="about-section">
        <h2>Feature your startup</h2>
        <p>
          Building something in India and want it listed as a case study? Send a short brief — what you do, who you serve, and what other founders can learn.
        </p>
        <div class="action-row">
          <button class="btn btn-primary" type="button" data-open-submit data-submit-type="startup">Register your startup</button>
        </div>
      </section>

      <section class="about-section">
        <h2>Join the conversation</h2>
        <p>
          Incorporation is lonely paperwork. Talk to other Indian founders, or send a question we should add to the FAQ.
        </p>
        <div class="community-links">
          <a href={site.reddit} class="social-link reddit" rel="noopener noreferrer" target="_blank">
            r/indianstartups
          </a>
          <button class="social-link" type="button" data-open-submit data-submit-type="question">Ask a FAQ question</button>
        </div>
      </section>
    </div>

    <div class="testimonial-section">
      <blockquote class="about-quote">
        Let's plant our startups like flowers in the garden of India, and help each other flourish.
      </blockquote>
      <div class="quote-author">— {site.name} community</div>
    </div>
  </article>
</Layout>

<style>
  .about-page {
    min-height: calc(100vh - 220px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 3rem 0;
  }

  .about-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .about-title {
    font-size: clamp(2.4rem, 5vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
    letter-spacing: -0.05em;
  }

  .about-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
  }

  .about-content {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .about-section h2 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .about-section p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .action-row {
    margin-top: 1.25rem;
  }

  .community-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .social-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--text-secondary);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }

  .social-link.reddit:hover {
    color: #ff4500;
  }

  .testimonial-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
    text-align: center;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
  }

  .about-quote {
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    font-weight: 600;
    font-style: italic;
    line-height: 1.45;
    margin-bottom: 1rem;
  }

  .quote-author {
    color: var(--accent-color);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .about-content {
      grid-template-columns: 1fr;
    }
  }
</style>
