---
import { site } from '../lib/site';
---

<div id="submit-modal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="submit-title">
  <div class="modal-content glass">
    <button id="close-modal" class="btn-close" type="button" aria-label="Close">✕</button>

    <h2 id="submit-title">Write to {site.name}</h2>
    <p class="modal-desc">Questions for the FAQ, a startup to feature, or feedback. This opens an email to {site.email}.</p>

    <form id="submit-form" class="submit-form">
      <div class="form-group">
        <label for="submission-type">I want to submit</label>
        <select id="submission-type" name="type" required>
          <option value="question">A question for the FAQ</option>
          <option value="startup">A startup to feature</option>
          <option value="feedback">General feedback</option>
        </select>
      </div>

      <div class="form-group">
        <label for="submission-details">Details</label>
        <textarea id="submission-details" name="details" rows="4" placeholder="What should we know?" required></textarea>
      </div>

      <div class="form-group">
        <label for="submission-email">Your email (optional)</label>
        <input type="email" id="submission-email" name="email" placeholder="you@company.in" />
      </div>

      <button type="submit" class="btn btn-primary btn-submit">Open email draft</button>
    </form>
  </div>
</div>

<script is:inline define:vars={{ contactEmail: site.email }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('submit-modal');
    const closeBtn = document.getElementById('close-modal');
    const form = document.getElementById('submit-form');
    const typeSelect = document.getElementById('submission-type');

    function openModal(type) {
      if (type && [...typeSelect.options].some((opt) => opt.value === type)) {
        typeSelect.value = type;
      }
      modal.classList.remove('hidden');
      typeSelect.focus();
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    document.addEventListener('openSubmitModal', (event) => {
      openModal(event.detail && event.detail.type);
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const type = typeSelect.value;
      const details = document.getElementById('submission-details').value.trim();
      const email = document.getElementById('submission-email').value.trim();
      const subject = encodeURIComponent(`[${type}] ${siteLabel(type)} — #Founder`);
      const body = encodeURIComponent(
        `Type: ${type}\n\n${details}\n\nFrom: ${email || 'not provided'}\n`
      );
      window.location.href = `mailto:${contactEmail}?subject=${subject}&body=${body}`;
      closeModal();
      form.reset();
    });

    function siteLabel(type) {
      if (type === 'question') return 'FAQ question';
      if (type === 'startup') return 'Startup feature';
      return 'Feedback';
    }
  });
</script>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modal-content {
    width: 100%;
    max-width: 500px;
    padding: 2.25rem;
    position: relative;
    background: var(--header-bg);
  }

  .btn-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1.2rem;
    cursor: pointer;
  }

  .modal-content h2 {
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
  }

  .modal-desc {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }

  .submit-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-group select,
  .form-group input,
  .form-group textarea {
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font: inherit;
    outline: none;
  }

  .form-group select:focus,
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent-color);
  }

  .form-group select option {
    background: var(--bg-color);
  }

  .btn-submit {
    width: 100%;
  }
</style>
