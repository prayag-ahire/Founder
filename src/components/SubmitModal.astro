---
import '../styles/global.css';
---

<div id="submit-modal" class="modal-backdrop hidden">
  <div class="modal-content glass">
    <button id="close-modal" class="btn-close" aria-label="Close modal">✕</button>
    
    <h2>Submit to #Founder</h2>
    <p class="modal-desc">Have a question you want answered or a startup you want featured? Let us know!</p>
    
    <form id="submit-form" class="submit-form">
      <div class="form-group">
        <label for="submission-type">I want to submit a...</label>
        <select id="submission-type" name="type" required>
          <option value="question">Question for FAQ</option>
          <option value="startup">Startup to Feature</option>
          <option value="feedback">General Feedback</option>
        </select>
      </div>

      <div class="form-group">
        <label for="submission-details">Details</label>
        <textarea id="submission-details" name="details" rows="4" placeholder="Tell us more..." required></textarea>
      </div>

      <div class="form-group">
        <label for="submission-email">Your Email (Optional)</label>
        <input type="email" id="submission-email" name="email" placeholder="hello@example.com" />
      </div>

      <button type="submit" class="btn btn-primary btn-submit">Submit Request</button>
    </form>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('submit-modal');
    const closeBtn = document.getElementById('close-modal');
    const form = document.getElementById('submit-form');
    
    // Listen for custom event to open modal
    document.addEventListener('openSubmitModal', () => {
      modal.classList.remove('hidden');
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
    });

    // Close on click outside
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Mock submit
      const btn = form.querySelector('.btn-submit');
      const originalText = btn.textContent;
      btn.textContent = 'Submitting...';
      btn.disabled = true;

      setTimeout(() => {
        btn.textContent = 'Submitted!';
        btn.style.background = '#10b981'; // Green
        
        setTimeout(() => {
          modal.classList.add('hidden');
          form.reset();
          btn.textContent = originalText;
          btn.style.background = '';
          btn.disabled = false;
        }, 1500);
      }, 1000);
    });
  });
</script>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    opacity: 1;
    visibility: visible;
    transition: all 0.3s ease;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modal-content {
    background: var(--header-bg);
    width: 100%;
    max-width: 500px;
    padding: 2.5rem;
    position: relative;
    transform: translateY(0);
    transition: transform 0.3s ease;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }

  .modal-backdrop.hidden .modal-content {
    transform: translateY(20px);
  }

  .btn-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .btn-close:hover {
    color: var(--text-primary);
  }

  .modal-content h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .modal-desc {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    font-size: 0.95rem;
  }

  .submit-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-group select,
  .form-group input,
  .form-group textarea {
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  .form-group select:focus,
  .form-group input:focus,
  .form-group textarea:focus {
    border-color: var(--accent-color);
  }

  .form-group select option {
    background: var(--bg-color);
    color: var(--text-primary);
  }

  .btn-submit {
    margin-top: 0.5rem;
    width: 100%;
    padding: 0.8rem;
  }
</style>
